   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import scipy\n",
    "from scipy.special import factorial"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "30d52f34",
   "metadata": {},
   "source": [
    "# N-particle Structure Factor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a1efd4f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def debye_waller(q, m, B, omegas, ell, N):\n",
    "    # result=0\n",
    "    # for nu in range(N-1):\n",
    "    #     result+= B[nu, ell]*np.conjugate(B[nu, ell])/omegas[nu]\n",
    "    result = np.sum(B[:, ell]*np.conjugate(B[:, ell])/omegas)* q**2/(4*m)\n",
    "    return result"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0adee09e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def combos_helper_function_diag(j_vector, B, omegas, N, ell):\n",
    "    '''\n",
    "    For each set of j, calculate the product in the structure factor in the diagonal term\n",
    "    '''\n",
    "    # tot=1\n",
    "    # for r in range(N):\n",
    "    #     if j_vector[r]!=0:\n",
    "    #         tot*=1/factorial(j_vector[r])*(B[ell][r]*np.conjugate(B[ell][r])/omegas[r])**j_vector[r]\n",
    "    ind = np.nonzero(np.array(j_vector))\n",
    "    tot = np.prod(1/factorial(j_vector[ind])*(B[ind, ell]*np.conjugate(B[ind, ell])/omegas[ind])**j_vector[ind])\n",
    "    return tot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "806813d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def combos_helper_function_offdiag(j_vector, B, omegas, N, ell, ell_prime):\n",
    "    # tot=1\n",
    "    # for r in range(N):\n",
    "    #     if j_vector[r]!=0:\n",
    "    #         tot*=1/factorial(j_vector[r])*(B[ell][r]*np.conjugate(B[ell_prime][r])/omegas[r])**j_vector[r]\n",
    "    ind = np.nonzero(np.array(j_vector))\n",
    "    tot = np.prod(1/factorial(j_vector[ind])*(B[ind, ell]*np.conjugate(B[ind, ell_prime])/omegas[ind])**j_vector[ind])\n",
    "    return tot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "2881eeab",
   "metadata": {},
   "outputs": [],
   "source": [
    "def diagonal_C_singleCombo(q, m, omegas, n, j_vector,N,ell,B, V=1):\n",
    "    '''\n",
    "    For each set of j, calculate one term in the summation of C_ll\n",
    "    '''\n",
    "    j_vector = np.array(j_vector)\n",
    "    expDebyeWaller = np.exp(-2*debye_waller(q, m, B, omegas, ell, N))\n",
    "    c=expDebyeWaller/V * (q**2/(2*m))**n * 2*np.pi * combos_helper_function_diag(j_vector, B, omegas, N, ell)\n",
    "    return c"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e09fc8d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def offDiagonal_C_singleCombo(q, m, omegas, n, j_vector, N ,ell, ell_prime, B , V=1, a=0.001):\n",
    "    j_vector = np.array(j_vector)\n",
    "    expDebyeWaller = np.exp(-debye_waller(q, m, B, omegas, ell, N)-debye_waller(q, m, B, omegas, ell_prime, N))\n",
    "    c=expDebyeWaller/V * (q**2/(2*m))**n * 2*np.pi*combos_helper_function_offdiag(j_vector, B, omegas, N, ell, ell_prime)\n",
    "    c = c*np.cos(q*a*(ell-ell_prime))\n",
    "    return c"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "1330de7f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def allj_One_n(n, N, end=[]):\n",
    "    # given n, N, find all possible sets of j\n",
    "    combos=[]\n",
    "    if N==1:\n",
    "        for row in end:\n",
    "            combos.append([n-sum(row)]+row)\n",
    "        return combos\n",
    "    if len(end)==0:\n",
    "        for value in range(n+1):\n",
    "            combos.append([value])\n",
    "        return allj_One_n(n, N-1, combos)\n",
    "    for row in end:\n",
    "        for j in range(n-sum(row)+1):\n",
    "            combos.append([j]+row)\n",
    "    return allj_One_n(n, N-1, combos)       "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "f92594a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def StructureFactorIntegral_singleCombo(q, m, omegas, n, j, N ,B , V=1, a=0.001, A=1):\n",
    "    # For each set of j, sum all C_ll terms over N\n",
    "    tot=np.zeros(len(q),dtype=np.complex128)\n",
    "    for ell in range(N):\n",
    "        for ell_prime in range(N):\n",
    "            if ell==ell_prime:\n",
    "                tot+=diagonal_C_singleCombo(q, m, omegas, n, j,N,ell,B, V)\n",
    "            else:\n",
    "                tot+=offDiagonal_C_singleCombo(q, m, omegas, n, j, N ,ell, ell_prime, B , V, a)\n",
    "    return A**2 * tot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "bc27150c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def StructureFactorIntegral_singleCombo_diag(q, m, omegas, n, j, N ,B , V=1, a=0.001, A=1):\n",
    "    # For each set of j, sum all C_ll terms over N\n",
    "    tot=np.zeros(len(q),dtype=np.complex128)\n",
    "    for ell in range(N):\n",
    "        tot+=diagonal_C_singleCombo(q, m, omegas, n, j, N,ell,B, V)\n",
    "    return A**2 * tot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "b98b0742",
   "metadata": {},
   "outputs": [],
   "source": [
    "def StructureFactorIntegral_allj(q, m, omegas, n, N ,B , V=1, a=0.001, A=1):\n",
    "    # sum over all sets of j\n",
    "    j_combos = allj_One_n(n, N-1)\n",
    "    tot=np.zeros(len(q),dtype=np.complex128)\n",
    "    for j in j_combos:\n",
    "        tot+= StructureFactorIntegral_singleCombo(q, m, omegas, n, j, N ,B , V, a, A)\n",
    "    return tot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "fb646992",
   "metadata": {},
   "outputs": [],
   "source": [
    "def StructureFactorIntegral_allj_diag(q, m, omegas, n, N ,B , V=1, a=0.001, A=1):\n",
    "    # sum over all sets of j\n",
    "    j_combos = allj_One_n(n, N-1)\n",
    "    tot=np.zeros(len(q),dtype=np.complex128)\n",
    "    for j in j_combos:\n",
    "        tot+= StructureFactorIntegral_singleCombo_diag(q, m, omegas, n, j, N ,B , V, a, A)\n",
    "    return tot"
   ]
  },
